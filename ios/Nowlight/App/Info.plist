<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>tr</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundleDisplayName</key><string>Nowlight</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>LSRequiresIPhoneOS</key><true/>
  <key>UILaunchScreen</key><dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array><string>UIInterfaceOrientationPortrait</string></array>
  <key>INAlternativeAppNames</key>
  <array>
    <dict>
      <key>INAlternativeAppName</key><string>Işık</string>
      <key>INAlternativeAppNamePronunciationHint</key><string>ışık</string>
    </dict>
  </array>
  <key>UIBackgroundModes</key>
  <array><string>fetch</string></array>
  <key>BGTaskSchedulerPermittedIdentifiers</key>
  <array><string>online.matestudios.nowlight.refresh</string></array>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Odadaki ışıkları kontrol eden köprüye (ev ağındaki ESP32) bağlanmak için gerekli.</string>
  <key>NSAppTransportSecurity</key>
  <dict><key>NSAllowsLocalNetworking</key><true/></dict>
</dict>
</plist>
